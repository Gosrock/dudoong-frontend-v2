# 공개 값(빌드 때 굽는다). 카카오 JS 키는 공개돼도 되는 값이다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서버 런타임 값(선택). 없으면 http://localhost:8080/api/v2 를 쓴다.
# API_INTERNAL_URL=http://localhost:8080/api/v2

# 로컬 개발: 브라우저의 /api 요청을 이 출처로 넘긴다(next dev 에서만).
# 서버 프리페치는 rewrite를 타지 않으므로 API_INTERNAL_URL도 같은 출처로 함께 준다.
# DEV_API_ORIGIN=https://staging.dudoong.com
# API_INTERNAL_URL=https://staging.dudoong.com/api/v2

# 배포 버전(이미지 빌드 인자). 비어 있으면 deploymentId 를 쓰지 않는다.
# GIT_SHA=
